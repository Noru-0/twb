{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1"
  },
  "reporters": [
    "default",
    [
      "jest-junit",
      {
        "outputDirectory": "coverage",
        "outputName": "junit-e2e.xml",
        "suiteName": "Integration Tests"
      }
    ]
  ]
}